# =====================================================================================
# OPSMEMORY AI - environment template.  Copy to `.env` and fill in.
#
# NOTHING here is exposed to the React app. Only VITE_* variables reach the browser.
# =====================================================================================

# --- Application ---------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=OpsMemory AI
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720

# Comma separated list of allowed browser origins (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------------------------------
# Default is a local SQLite file so the platform runs with zero infrastructure.
# For production use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://opsmemory:opsmemory@localhost:5432/opsmemory
DATABASE_URL=sqlite:///./opsmemory.db

# --- OpenAI (reasoning layer) --------------------------------------------------------
# Leave empty to run in OFFLINE mode: a deterministic, evidence-driven reasoner takes over.
# The full learning loop still works offline; only the natural-language reasoning is
# templated instead of generated. Every tool, memory and verification path is identical.
#
# Any OpenAI-compatible endpoint works - for example Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
OPENAI_MAX_TOOL_ROUNDS=6
OPENAI_TEMPERATURE=0

# --- Hindsight (organizational memory) ----------------------------------------------
# Two supported setups:
#   A) Hindsight Cloud   HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
#                        HINDSIGHT_API_KEY=hsk_xxx
#   B) Self hosted       docker run -p 8888:8888 -e HINDSIGHT_API_LLM_API_KEY=$OPENAI_API_KEY \
#                          ghcr.io/vectorize-io/hindsight:latest
#                        HINDSIGHT_BASE_URL=http://localhost:8888
#
# If HINDSIGHT_BASE_URL is empty OR the server is unreachable, OpsMemory AI falls back to
# its built-in memory implementation (same interface, same semantics) and records
# MEMORY_DEGRADED on the investigation. The demo never dies on venue wifi.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=opsmemory-org
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=2048
HINDSIGHT_TIMEOUT_SECONDS=30
# When true the platform refuses to start without a reachable Hindsight server.
HINDSIGHT_REQUIRED=false

# --- Clock ---------------------------------------------------------------------------
# simulated = the demo world (default). A fast-forward clock generates telemetry, so the
#             learning loop is fully reproducible with no infrastructure.
# real      = bind the platform to wall-clock UTC and feed it through the ingestion API
#             below. Use this to observe a real project. It also stops seeding the eight
#             fabricated demo services, so the dashboard shows only your own systems.
CLOCK_MODE=simulated

# --- Simulated environment (the evidence substrate) ----------------------------------
# 1 simulated second is produced every SIM_TICK_MS of wall clock.
SIM_TICK_MS=250
SIM_SECONDS_PER_TICK=2
SIM_RETENTION_MINUTES=180

# --- Ingestion (connecting a real project) -------------------------------------------
# Push telemetry from any system with:
#   python -m app.connectors.tail_logs --service my-api --log-file ./app.log
#
# Shared secret for that connector. When set, the connector sends X-Ingest-Token and needs
# no user account. When EMPTY, ingestion requires a signed-in user holding the
# ingest_telemetry permission - which is the safe default, because an open write endpoint
# would let anyone fabricate an incident. Set a long random value for anything reachable
# beyond localhost.
INGEST_TOKEN=

# Create unknown projects, environments and services on their first sample, so any project
# can connect without a manual catalogue step. Set false to require explicit registration.
INGEST_AUTOREGISTER=true

# Per-service ceiling on ingested telemetry rows per minute. Absorbs a runaway connector
# instead of letting it become a fabricated mass incident.
INGEST_SERVICES_PER_MINUTE=600

# Reject a single request larger than this, and reject samples stamped further than this
# many seconds into the future (a wrong-clock guard).
INGEST_MAX_BATCH=5000
INGEST_MAX_SKEW_SECONDS=300

# --- Remediation safety --------------------------------------------------------------
# Highest autonomy level the platform (and the AI) may act at. 4 = execute approved only.
MAX_AUTONOMY_LEVEL=4
APPROVAL_REQUIRED_ABOVE_RISK=low
REMEDIATION_MAX_RETRIES=2
VERIFICATION_SETTLE_SECONDS=45
VERIFICATION_MIN_IMPROVEMENT_PCT=25

# --- GitHub / CI-CD (optional integration) ------------------------------------------
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO=
